#!/usr/bin/env bash
# Stand-in for the VPN command-line tool, for the tests: same output shapes, state in $FAKE_VPN_DIR.
D="${FAKE_VPN_DIR:?set FAKE_VPN_DIR}"; mkdir -p "$D"
echo "$*" >> "$D/calls"
B=$'\033[1m'; R=$'\033[0m'
case "${1:-}" in
status)
    if [[ -f "$D/connected" ]]; then echo "Connected to $(cat "$D/connected") in TUN mode, running on tun0"
    else echo "VPN is disconnected"; echo "You can connect to a location by running \`fake connect -l 'x'\`"; fi ;;
license)
    if [[ -f "$D/user" ]]; then
        echo "Logged in as $B$(cat "$D/user")$R"; echo "You are using the ${B}PREMIUM$R version"
        echo "Up to ${B}10$R devices simultaneously"; echo "Your subscription is valid until 2030-01-31"
    else echo "You are not logged in. Run 'login'."; fi ;;
list-locations)
    printf '%sISO   COUNTRY              CITY                           PING ESTIMATE\n%s' "$B" "$R"
    printf 'NL    Netherlands          Amsterdam                      24        \n'
    printf 'US    United States        New York                       95        \n'
    printf 'JP    Japan                Tokyo                          240       \n\n'
    echo "You can connect to a location by running \`fake connect -l 'x'\`" ;;
connect)
    [[ -f "$D/user" ]] || { echo "Error: not logged in" >&2; exit 1; }
    [[ -n "${FAKE_FAIL:-}" ]] && { echo "Error: ${FAKE_FAIL}" >&2; exit 1; }
    loc="AMSTERDAM, Netherlands"
    while (( $# )); do [[ $1 == -l ]] && { loc="$2"; shift; }; shift; done
    echo "$loc" > "$D/connected"; echo "Successfully Connected to $loc" ;;
disconnect) rm -f "$D/connected"; echo "Successfully Disconnected" ;;
login)
    read -r email; read -r pass
    [[ -n "$pass" && "$pass" != wrong ]] || { echo "Error: invalid credentials" >&2; exit 1; }
    echo "$email" > "$D/user"; echo "Successfully Logged in" ;;
logout) rm -f "$D/user" "$D/connected"; echo "Successfully Logged out" ;;
site-exclusions)
    shift; sub="${1:-}"; shift || true
    mode=$(cat "$D/exmode" 2>/dev/null || echo general)
    case "$sub" in
    show) echo "Exclusions for ${mode^^} mode:"; [[ -f "$D/exclusions" ]] && sort "$D/exclusions"; echo ;;
    add) for x in "$@"; do echo "$x" >> "$D/exclusions"; done; echo "Successfully added $# exclusions" ;;
    remove) for x in "$@"; do grep -vxF -- "$x" "$D/exclusions" > "$D/exclusions.new" 2>/dev/null; mv "$D/exclusions.new" "$D/exclusions"; done
            echo "Successfully removed $# exclusions" ;;
    clear) rm -f "$D/exclusions"; echo "Successfully cleared exclusions" ;;
    mode) if [[ -n "${1:-}" ]]; then echo "$1" > "$D/exmode"; echo "Exclusion mode set to ${1^^}"; else echo "Current exclusion mode is ${mode^^}"; fi ;;
    esac ;;
config)
    shift; sub="${1:-}"; shift || true
    case "$sub" in
    show)
        g() { cat "$D/cfg-$1" 2>/dev/null || echo "$2"; }
        echo "Current configuration:"
        printf '\tMode: %s\n' "$(g mode tun)"
        printf '\tDNS upstream: %s\n' "$(g dns 'Default (provided by AdGuard VPN)')"
        printf '\tChange system DNS: %s\n' "$(g change-system-dns off)"
        printf '\tProtocol: %s\n' "$(g protocol 'Default (auto)')"
        printf '\tPost-quantum cryptography: %s\n' "$(g post-quantum 'Default (on)')"
        printf '\tShow notifications: %s\n' "$(g show-notifications 'Default (off)')" ;;
    set-*) echo "$1" > "$D/cfg-${sub#set-}"; echo "Successfully set ${sub#set-}" ;;
    esac ;;
--version) echo "AdGuard VPN CLI v9.9.9" ;;
export-logs) shift; out="."; while (( $# )); do [[ $1 == -o ]] && { out="$2"; shift; }; shift; done
    echo logs > "$out/adguard_vpn_logs.zip"; echo "Logs exported to $out/adguard_vpn_logs.zip" ;;
check-update) echo "You are using the latest version" ;;
*) echo "unknown command" >&2; exit 2 ;;
esac
