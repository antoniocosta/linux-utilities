            row.pack_start(Gtk.Label(label=title, xalign=0), True, True, 0)
            sw = Gtk.Switch(valign=Gtk.Align.CENTER)
            sw.connect("state-set", lambda w, state, k=key: self.on_switch_setting(k, state))
