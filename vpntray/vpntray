    # ---- showing and hiding ----
    def row_visible(self, model, it, _data):
        q = self.search.get_text().strip().lower()
        return not q or all(p in model[it][4] for p in q.split())

    def on_focus_out(self, *_):
        if time.monotonic() - self.shown_at > 0.4:  # ignore the focus flicker while mapping
            self.hide_panel()
        return False

    def hide_panel(self):
        self.win.hide()
        self.stop_stats()

    def show_panel(self, tab="home", focus_search=False):
        self.shown_at = time.monotonic()
        self.search.set_text("")
        self.set_error("")
        display = Gdk.Display.get_default()
        _, px, py = display.get_default_seat().get_pointer().get_position()
        mon = display.get_monitor_at_point(px, py)
        wa = mon.get_workarea()
        x = max(wa.x + 8, min(px - WIDTH // 2, wa.x + wa.width - WIDTH - 8))
        self.win.move(x, wa.y + 4)
        self.win.show()
        self.win.present()
        index = TABS.index(tab)
        if self.nb.get_current_page() == index:
            self.on_tab(self.nb, None, index)
        self.nb.set_current_page(index)
        if focus_search:
            self.search.grab_focus()
        self.refresh()

    def on_tab(self, _nb, _page, num):
        tab = TABS[num]
        self.on_stats = tab == "stats"
        if tab == "exclusions":
            self.load_exclusions()
        elif tab == "stats":
            self.start_stats()
        elif tab == "support":
            self.lbl_version.set_text("...")
            bg(self.vpn.version, lambda v: self.lbl_version.set_text(v if isinstance(v, str) else ""))
        elif tab == "settings":
            self.load_settings()
        if tab != "stats":
            self.stop_stats()

    def set_error(self, msg):
        self.error.set_text(msg)
        self.error.set_visible(bool(msg))

    # ---- rendering the state ----
    busy_what = ""                                # "connect" / "disconnect" while one is running

    def render(self):
        on = bool(self.status and self.status.connected)
        logged_in = bool(self.account is None or self.account.logged_in)
        self.home_stack.set_visible_child_name("main" if logged_in else "login")
        if self.busy:
            pass
        elif self.status is None:
            self.lbl_status.set_text("Checking...")
        else:
            self.lbl_status.set_text("Connected" if on else "Disconnected")
            self.lbl_loc.set_text(self.location_label())
        self.switch.handler_block_by_func(self.on_switch)
        self.switch.set_active(on)
        self.switch.set_state(on)
        self.switch.handler_unblock_by_func(self.on_switch)
        for wdg in [self.switch] + self.main_widgets:
            wdg.set_sensitive(not self.busy)
        if self.account and self.account.logged_in:
            plan = f"  ({self.account.plan})" if self.account.plan else ""
            until = f"\nValid until {self.account.valid_until}" if self.account.valid_until else ""
            self.lbl_acc.set_text(f"{self.account.email}{plan}{until}")
        elif self.account is not None:
            self.lbl_acc.set_text("Not logged in")
        if on and not self.connected_at:
            self.connected_at = time.monotonic()
        elif not on:
            self.connected_at = None
        self.update_tray()
        if self.stats_timer:
            self.tick_stats()

    def refresh(self, status_only=False):
        def work():
            st = self.vpn.status()
            acc = None if status_only else self.vpn.account()
            locs = None
            if (not status_only and acc.logged_in
                    and (not self.locations or time.monotonic() - self.loc_time > 300)):
                locs = self.vpn.locations()
            return st, acc, locs

        def done(res):
            if isinstance(res, Exception):
                self.set_error(str(res))
                return
            st, acc, locs = res
            self.status = st
            if acc is not None:
                self.account = acc
            if locs:
                self.locations = locs
                self.loc_time = time.monotonic()
                self.fill_locations()
                self.fill_connect_menu()
            self.render()

        bg(work, done)

    def fill_locations(self):
        self.store.clear()
        for loc in self.locations:
            ping = f"{loc.ping} ms" if loc.ping >= 0 else ""
            self.store.append([f"{loc.flag} {loc.country}".strip(), loc.city, ping, loc.ping,
                               f"{loc.iso} {loc.country} {loc.city}".lower()])

    # ---- actions --------------------------------------------------------------------
    def act(self, what, label, fn, expect):
        """Run a CLI action in the background, show progress, then re-check the status."""
        if self.busy:
            return
        self.busy = True
        self.busy_what = what
        self.set_error("")
        self.lbl_status.set_text(label)
        self.lbl_loc.set_text("")
        self.render()

        def done(res):
            if isinstance(res, Exception):
                self.set_error(str(res))
            elif not res.ok:
                self.set_error(res.message or "The command failed")
            self.settle(expect if not isinstance(res, Exception) and res.ok else None, 8)
        bg(fn, done)

    def settle(self, expect, tries):
        """Re-read the status; if it has not reached `expect` yet, a few quick re-checks."""
        def done(st):
            if not isinstance(st, Exception):
                self.status = st
            if (expect is not None and not isinstance(st, Exception) and st.connected != expect
                    and tries > 0):
                GLib.timeout_add(1000, lambda: (self.settle(expect, tries - 1), False)[1])
                return
            self.busy = False
            self.busy_what = ""
            self.render()
            if self.account is None or not self.account.logged_in:
                self.refresh()
        bg(self.vpn.status, done)

    def connect_to(self, city, title=None):
        if title:
            self.state["last"] = title
            self.state["city"] = city
            core.save_state(self.state)
        self.act("connect", "Connecting...", lambda: self.vpn.connect(city), True)

    def disconnect(self):
        self.act("disconnect", "Disconnecting...", self.vpn.disconnect, False)

    def toggle(self):
        if self.status and self.status.connected:
            self.disconnect()
        else:
            self.connect_to(self.state.get("city"), self.state.get("last"))

    def on_switch(self, _sw, state):
        if state != bool(self.status and self.status.connected):
            self.toggle()
        return True  # render() sets the real state

    def on_row(self, tree, path, _col):
        row = tree.get_model()[path]
        self.connect_to(row[1], f"{row[0].split(' ', 1)[-1]}, {row[1]}")

    def on_login(self, *_):
        email, pw = self.in_email.get_text().strip(), self.in_pass.get_text()
        if not email or not pw:
            self.set_error("Enter your email and password.")
            return
        self.in_pass.set_text("")

        def done(res):
            self.btn_login.set_sensitive(True)
            if isinstance(res, Exception) or not res.ok:
                self.set_error(str(res) if isinstance(res, Exception) else (res.message or "Login failed"))
            else:
                self.in_email.set_text("")
                self.refresh()
        self.btn_login.set_sensitive(False)
        self.set_error("")
        bg(lambda: self.vpn.login(email, pw), done)

    def on_logout(self, *_):
        def done(res):
            if isinstance(res, Exception) or not res.ok:
                self.set_error(str(res) if isinstance(res, Exception) else (res.message or "Log out failed"))
            self.status = None
            self.account = None
            self.locations = []
            self.store.clear()
            self.fill_connect_menu()
            self.refresh()
        bg(self.vpn.logout, done)

    # ---- exclusions ----
    def load_exclusions(self):
        def done(res):
            if isinstance(res, Exception):
                self.set_error(str(res))
                return
            self.excl_mode, self.excl_items = res
            self.loading = True
            self.cb_excl_mode.set_active_id(self.excl_mode if self.excl_mode in ("general", "selective") else "general")
            self.excl_store.clear()
            for entry in self.excl_items:
                self.excl_store.append([entry])
            self.loading = False
        bg(self.vpn.exclusions, done)

    def after_excl(self, res):
        if isinstance(res, Exception) or not res.ok:
            self.set_error(str(res) if isinstance(res, Exception) else (res.message or "The command failed"))
        else:
            self.set_error("")
        self.load_exclusions()

    def on_excl_mode(self, cb):
        if self.loading or not cb.get_active_id() or cb.get_active_id() == self.excl_mode:
            return
        mode = cb.get_active_id()
        bg(lambda: self.vpn.set_exclusion_mode(mode), self.after_excl)

    def on_excl_add(self, *_):
        items = self.in_excl.get_text().replace(",", " ").split()
        if not items:
            return
        self.in_excl.set_text("")
        bg(lambda: self.vpn.add_exclusions(items), self.after_excl)

    def on_excl_remove(self, *_):
        model, paths = self.excl_tree.get_selection().get_selected_rows()
        items = [model[p][0] for p in paths]
        if items:
            bg(lambda: self.vpn.remove_exclusions(items), self.after_excl)

    def on_excl_clear(self, *_):
        bg(self.vpn.clear_exclusions, self.after_excl)

    # ---- stats ----
    def start_stats(self):
        if not self.stats_timer:
            self.stats_timer = GLib.timeout_add_seconds(2, self.tick_stats)
        self.tick_stats()

    def stop_stats(self):
        if self.stats_timer:
            GLib.source_remove(self.stats_timer)
            self.stats_timer = 0

    def tick_stats(self):
        if not self.win.get_visible() or not self.on_stats:
            self.stats_timer = 0
            return False
        on = bool(self.status and self.status.connected)
        traffic = core.tun_traffic() if on else None
        up = core.service_uptime() if on else None
        if on and up is None and self.connected_at:
            up = time.monotonic() - self.connected_at
        self.stat_labels["status"].set_text("Connected" if on else "Disconnected")
        self.stat_labels["location"].set_text(self.location_label())
        self.stat_labels["time"].set_text(core.human_duration(up) if up is not None else "-")
        self.stat_labels["down"].set_text(core.human_bytes(traffic[0]) if traffic else "-")
        self.stat_labels["up"].set_text(core.human_bytes(traffic[1]) if traffic else "-")
        return True

    # ---- support ----
    def open_url(self, url):
        Gtk.show_uri_on_window(None, url, Gdk.CURRENT_TIME)

    def on_export_logs(self, *_):
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or os.path.expanduser("~")
        self.lbl_support.set_text("Exporting...")

        def done(res):
            if isinstance(res, Exception):
                self.lbl_support.set_text(str(res))
            else:
                self.lbl_support.set_text(res.message if res.ok else (res.message or "Export failed"))
        bg(lambda: self.vpn.export_logs(folder), done)

    def on_check_update(self, *_):
        self.lbl_support.set_text("Checking...")

        def done(res):
            if isinstance(res, Exception):
                self.lbl_support.set_text(str(res))
            else:
                self.lbl_support.set_text(res.message or "Done")
        bg(self.vpn.check_update, done)

    # ---- settings ----
    def load_settings(self):
        def done(cfg):
            if isinstance(cfg, Exception):
                self.set_error(str(cfg))
                return
            self.config = cfg
            self.loading = True
            self.cb_mode.set_active_id(cfg.mode)
            self.cb_protocol.set_active_id(cfg.protocol)
            self.in_dns.set_text("" if cfg.dns == "default" else cfg.dns)
            for key, sw in self.sw_settings.items():
                sw.set_active(getattr(cfg, key))
                sw.set_state(getattr(cfg, key))
            self.loading = False
        bg(self.vpn.config, done)

    def on_setting(self, key, value):
        if self.loading or value is None or (self.config and getattr(self.config, key, None) == value):
            return

        def done(res):
            if isinstance(res, Exception) or not res.ok:
                self.set_error(str(res) if isinstance(res, Exception) else (res.message or "The setting was not changed"))
            else:
                self.set_error("")
            self.load_settings()
        bg(lambda: self.vpn.set_config(key, value), done)

    def on_switch_setting(self, key, state):
        self.on_setting(key, bool(state))
        return False


def set_process_name(name):
    """So it can be found (and restarted) by its exact process name, not as 'python3'."""
    try:
        import ctypes
        ctypes.CDLL(None).prctl(15, name.encode(), 0, 0, 0)
    except Exception:
        pass


if __name__ == "__main__":
    set_process_name("vpntray")
    sys.exit(App().run(sys.argv))
