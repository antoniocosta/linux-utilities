#!/usr/bin/env python3
"""vpntray: a light top-bar menu and panel for a VPN command-line tool (unofficial; not affiliated with AdGuard).

The menu (click the mask in the top bar) is laid out like the macOS app's:
    Status / Location, Connect / Disconnect, Connect to >, Open / Exclusions / Stats / Support / Settings, Quit.
The panel has the same tabs: Home, Exclusions, Stats, Support, Settings.

Event-driven: no timers while idle. The status is read at start, when the panel opens, after each action and
whenever the network changes (the kernel says so through `ip monitor`); the Stats tab refreshes every 2 seconds
only while it is on screen.
"""
import os
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import vpntray_core as core  # noqa: E402
from vpntray_core import AdGuard, LinkWatch  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.vpntray.Tray"
WIDTH = 400
TABS = ("home", "exclusions", "stats", "support", "settings")
TAB_TITLES = {"home": "Home", "exclusions": "Exclusions", "stats": "Stats", "support": "Support", "settings": "Settings"}
MENU_LOCATIONS = 12                         # how many of the fastest locations the "Connect to" menu lists
SUPPORT_URL = "https://adguard-vpn.com/support/"
CSS = b"""
.vt-status { font-size: 15px; font-weight: bold; }
.vt-dim { opacity: 0.65; font-size: 11px; }
.vt-error { color: #e5484d; font-size: 11px; }
.vt-head { font-weight: bold; }
"""


def bg(fn, done):
    """Run fn in a thread; call done(result) on the GTK main loop."""
    def work():
        try:
            res = fn()
        except Exception as e:  # never let a worker die silently
            res = e
        GLib.idle_add(done, res)
    threading.Thread(target=work, daemon=True).start()


def dim(text, wrap=True):
    lbl = Gtk.Label(label=text, xalign=0)
    lbl.get_style_context().add_class("vt-dim")
    lbl.set_line_wrap(wrap)
    lbl.set_max_width_chars(46)
    return lbl


def page_box():
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.set_border_width(10)
    return box


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        askpass = os.path.join(HERE, "vpntray-askpass")
        self.vpn = AdGuard(os.environ.get("VPNTRAY_CLI", "adguardvpn-cli"), askpass)
        self.status = None
        self.account = None
        self.locations = []
        self.loc_time = 0.0
        self.config = None
        self.excl_mode, self.excl_items = "general", []
        self.state = core.load_state()           # {"last": "Country, City"}: where it connected last
        self.connected_at = None                 # when we saw it connect (if the service's start time is unknown)
        self.busy = False
        self.shown_at = 0.0
        self.win = None
        self.indicator = None
        self.link = None
        self.link_timer = 0
        self.stats_timer = 0
        self.on_stats = False                    # the Stats tab is the one showing
        self.loading = False                     # filling widgets from the tool: ignore their change signals

    # ---- lifecycle ------------------------------------------------------------------
    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        if self.win is None:
            self.hold()
            self.build_indicator()
            self.build_window()
            self.refresh()
            self.watch_network()
        tab = next((a.split("=", 1)[1] for a in args if a.startswith("--tab=")), "home")
        if "--background" not in args:
            self.show_panel(tab if tab in TABS else "home")
        return 0

    # ---- the VPN changing without us -------------------------------------------------
    def watch_network(self):
        """The icon must show the real state, also when the VPN was connected or dropped by something else
        (the command line, a reconnect). The kernel tells us when an interface changes; nothing is polled."""
        try:
            self.link = LinkWatch()
        except OSError:
            self.link = None
            return
        GLib.io_add_watch(self.link.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, self.on_link)

    def on_link(self, _fd, _cond):
        if self.link.read() is None:                       # the monitor ended: start it again in a while
            self.link.close()
            self.link = None
            GLib.timeout_add_seconds(10, lambda: (self.watch_network(), False)[1])
            return False
        if not self.link_timer:                            # several events arrive together: look once
            self.link_timer = GLib.timeout_add(1000, self.link_changed)
        return True

    def link_changed(self):
        self.link_timer = 0
        if not self.busy:
            self.refresh(status_only=True)
        return False

    # ---- the menu in the top bar ----------------------------------------------------
    def build_indicator(self):
        icons = os.path.join(HERE, "icons")
        icon_dir = icons if os.path.isdir(icons) else ""
        self.indicator = AppIndicator.Indicator.new_with_path(
            "vpntray", "vpntray-off", AppIndicator.IndicatorCategory.APPLICATION_STATUS, icon_dir)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        name = self.vpn.name
        menu = Gtk.Menu()

        def item(label, handler=None, sensitive=True):
            mi = Gtk.MenuItem(label=label)
            mi.set_sensitive(sensitive)
            if handler:
                mi.connect("activate", handler)
            menu.append(mi)
            return mi

        self.mi_state = item("Status: ...", sensitive=False)
        self.mi_loc = item("Location: ...", sensitive=False)
        menu.append(Gtk.SeparatorMenuItem())
        self.mi_connect = item("Connect", lambda *_: self.connect_to(self.state.get("city"), self.state.get("last")))
        self.mi_disconnect = item("Disconnect", lambda *_: self.disconnect())
        menu.append(Gtk.SeparatorMenuItem())
        self.mi_connect_to = item("Connect to")
        self.sub_connect = Gtk.Menu()
        self.mi_connect_to.set_submenu(self.sub_connect)
        self.fill_connect_menu()
        menu.append(Gtk.SeparatorMenuItem())
        item(f"Open {name}", lambda *_: self.show_panel("home"))
        for tab in TABS[1:]:
            item(TAB_TITLES[tab], lambda *_, t=tab: self.show_panel(t))
        menu.append(Gtk.SeparatorMenuItem())
        item(f"Quit {name}", lambda *_: self.quit())
        menu.show_all()
        self.indicator.set_menu(menu)
        self.indicator.set_secondary_activate_target(self.mi_connect_to)

    def loc_title(self, loc):
        return f"{loc.country}, {loc.city}"

    def fill_connect_menu(self):
        """"Connect to >": the fastest locations with their flags, and "Other servers..." for the rest."""
        for child in self.sub_connect.get_children():
            self.sub_connect.remove(child)
        fastest = Gtk.MenuItem(label="Fastest location")
        fastest.connect("activate", lambda *_: self.connect_to(None, "Fastest location"))
        self.sub_connect.append(fastest)
        self.sub_connect.append(Gtk.SeparatorMenuItem())
        for loc in [x for x in self.locations if x.ping >= 0][:MENU_LOCATIONS] or self.locations[:MENU_LOCATIONS]:
            mi = Gtk.MenuItem(label=f"{loc.flag}  {self.loc_title(loc)}".strip())
            mi.connect("activate", lambda *_, loc=loc: self.connect_to(loc.city, self.loc_title(loc)))
            self.sub_connect.append(mi)
        if self.locations:
            self.sub_connect.append(Gtk.SeparatorMenuItem())
        other = Gtk.MenuItem(label="Other servers...")
        other.connect("activate", lambda *_: self.show_panel("home", focus_search=True))
        self.sub_connect.append(other)
        self.sub_connect.show_all()

    def location_label(self):
        """"Switzerland, Zurich": where it is connected, else where it connected last."""
        if self.status and self.status.connected and self.status.location:
            city = self.status.location.casefold()
            for loc in self.locations:
                if loc.city.casefold() == city:
                    return self.loc_title(loc)
            return self.status.location.title()
        return self.state.get("last") or "Fastest location"

    def update_tray(self):
        on = bool(self.status and self.status.connected)
        logged_in = bool(self.account is None or self.account.logged_in)
        self.indicator.set_icon_full("vpntray-on" if on else "vpntray-off",
                                     f"{self.vpn.name} on" if on else f"{self.vpn.name} off")
        word = "Connecting..." if self.busy_what == "connect" else "Disconnecting..." if self.busy_what == "disconnect" \
            else ("Connected" if on else "Disconnected")
        self.mi_state.set_label(f"Status: {word}")
        self.mi_loc.set_label(f"Location: {self.location_label()}")
        self.mi_connect.set_sensitive(not on and not self.busy and logged_in)
        self.mi_disconnect.set_sensitive(on and not self.busy)
        self.mi_connect_to.set_sensitive(not self.busy and logged_in)

    # ---- the panel (tabs) -----------------------------------------------------------
    def build_window(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        w = self.win = Gtk.Window(title=self.vpn.name)
        w.set_decorated(False)
        w.set_resizable(False)
        w.set_skip_taskbar_hint(True)
        w.set_skip_pager_hint(True)
        w.set_keep_above(True)
        w.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        w.set_default_size(WIDTH, -1)
        w.stick()
        w.connect("focus-out-event", self.on_focus_out)
        w.connect("key-press-event", lambda _w, e: self.hide_panel() if e.keyval == Gdk.KEY_Escape else None)
        w.connect("delete-event", lambda *_: (self.hide_panel(), True)[1])

        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.OUT)
        w.add(frame)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        frame.add(box)

        self.nb = Gtk.Notebook()
        self.nb.set_show_border(False)
        self.nb.set_tab_pos(Gtk.PositionType.TOP)
        builders = {"home": self.build_home, "exclusions": self.build_exclusions, "stats": self.build_stats,
                    "support": self.build_support, "settings": self.build_settings}
        for tab in TABS:
            self.nb.append_page(builders[tab](), Gtk.Label(label=TAB_TITLES[tab]))
        self.nb.connect("switch-page", self.on_tab)
        box.pack_start(self.nb, True, True, 0)

        self.error = Gtk.Label(xalign=0)
        self.error.set_line_wrap(True)
        self.error.set_max_width_chars(46)
        self.error.set_margin_start(10)
        self.error.set_margin_bottom(6)
        self.error.get_style_context().add_class("vt-error")
        self.error.set_no_show_all(True)
        box.pack_start(self.error, False, False, 0)
        frame.show_all()
        self.error.hide()

    # ---- Home ----
    def build_home(self):
        self.home_stack = Gtk.Stack()
        self.home_stack.set_vhomogeneous(False)
        self.home_stack.add_named(self.build_main(), "main")
        self.home_stack.add_named(self.build_login(), "login")
        return self.home_stack

    def build_main(self):
        box = page_box()
        head = Gtk.Box(spacing=10)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.lbl_status = Gtk.Label(label="Checking...", xalign=0)
        self.lbl_status.get_style_context().add_class("vt-status")
        self.lbl_loc = Gtk.Label(label="", xalign=0)
        self.lbl_loc.get_style_context().add_class("vt-dim")
        self.lbl_loc.set_ellipsize(3)
        texts.pack_start(self.lbl_status, False, False, 0)
        texts.pack_start(self.lbl_loc, False, False, 0)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("state-set", self.on_switch)
        head.pack_start(texts, True, True, 0)
        head.pack_end(self.switch, False, False, 0)
        box.pack_start(head, False, False, 0)

        self.btn_fastest = Gtk.Button(label="Fastest location")
        self.btn_fastest.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_fastest.get_child().set_xalign(0)
        self.btn_fastest.connect("clicked", lambda *_: self.connect_to(None, "Fastest location"))
        box.pack_start(self.btn_fastest, False, False, 0)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search locations")
        self.search.connect("search-changed", lambda *_: self.filter.refilter())
        box.pack_start(self.search, False, False, 0)

        # flag + country, city, ping text, ping, search key
        self.store = Gtk.ListStore(str, str, str, int, str)
        self.filter = self.store.filter_new()
        self.filter.set_visible_func(self.row_visible)
        tv = self.tree = Gtk.TreeView(model=self.filter)
        tv.set_headers_visible(False)
        tv.set_enable_search(False)
        for i, (xalign, expand) in enumerate(((0, True), (0, True), (1, False))):
            r = Gtk.CellRendererText(xalign=xalign)
            if i == 2:
                r.set_property("foreground", "#8a8a8a")
            col = Gtk.TreeViewColumn("", r, text=i)
            col.set_expand(expand)
            tv.append_column(col)
        tv.connect("row-activated", self.on_row)
        sw = Gtk.ScrolledWindow()
        sw.set_min_content_height(240)
        sw.set_shadow_type(Gtk.ShadowType.IN)
        sw.add(tv)
        box.pack_start(sw, True, True, 0)
        self.main_widgets = [self.btn_fastest, self.search, tv]
        return box

    def build_login(self):
        box = page_box()
        t = Gtk.Label(label=f"Log in to {self.vpn.name}", xalign=0)
        t.get_style_context().add_class("vt-status")
        self.in_email = Gtk.Entry(placeholder_text="Email")
        self.in_pass = Gtk.Entry(placeholder_text="Password", visibility=False)
        self.in_pass.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.btn_login = Gtk.Button(label="Log in")
        self.btn_login.get_style_context().add_class("suggested-action")
        self.btn_login.connect("clicked", self.on_login)
        self.in_email.connect("activate", lambda *_: self.in_pass.grab_focus())
        self.in_pass.connect("activate", self.on_login)
        for wdg in (t, self.in_email, self.in_pass, self.btn_login):
            box.pack_start(wdg, False, False, 0)
        return box

