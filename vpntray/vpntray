    # ---- Stats ----
    def build_stats(self):
        box = page_box()
        grid = Gtk.Grid(column_spacing=16, row_spacing=8)
        self.stat_labels = {}
        for i, (key, title) in enumerate((("status", "Status"), ("location", "Location"), ("time", "Connected for"),
                                          ("down", "Downloaded"), ("up", "Uploaded"))):
            grid.attach(Gtk.Label(label=title, xalign=0), 0, i, 1, 1)
            lbl = Gtk.Label(label="-", xalign=0)
            lbl.get_style_context().add_class("vt-head")
            grid.attach(lbl, 1, i, 1, 1)
            self.stat_labels[key] = lbl
        box.pack_start(grid, False, False, 0)
        box.pack_start(dim("Traffic through the VPN tunnel since it was connected, as counted by the system."), False, False, 0)
        return box

